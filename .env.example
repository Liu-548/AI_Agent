# ASCII ONLY - see QUY_TAC_THIET_KE.md rule DT-06.
# Copy this file to .env and fill in your keys. NEVER commit .env.
# ===========================================================================
# HYBRID SETUP - two providers, on purpose:
#
#   Groq   -> text path: supervisor + research (high volume)
#             Free tier: gpt-oss-120b / gpt-oss-20b about 1,000 req/day each.
#             NOTE: llama-3.3-70b-versatile and llama-3.1-8b-instant were
#             retired for free tier on 2026-08-16. Always confirm with:
#                 python -m app.main --models
#             Get a key: https://console.groq.com/keys   (starts with gsk_)
#
#   Gemini -> image path: vision agent + image_describer + utility
#             Free tier is small (~20 req/day per model) but that is plenty,
#             because only one role uses it.
#             Get a key: https://aistudio.google.com/apikey  (starts with AQ.)
#
# Why: Gemini free tier gives ~20 requests/day PER MODEL, and one supervisor
# question costs 4-6 LLM calls. Groq gives 50-700x more room to develop.
# ===========================================================================

# --- Keys (both required for the hybrid setup) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# Default provider used when a MODEL_* has no "provider:" prefix.
LLM_PROVIDER=groq

# Only for LLM_PROVIDER=openai (real OpenAI, Ollama, ...). Leave empty otherwise.
LLM_BASE_URL=

# --- One model per role, syntax "provider:model" ---
#
# FIVE roles -> FIVE different models on purpose: quota is counted per model,
# so pointing two roles at the same model halves your daily runs.
# Check what each role uses:  python -m app.main --config
MODEL_SUPERVISOR=groq:openai/gpt-oss-120b
MODEL_RESEARCH=groq:openai/gpt-oss-20b
MODEL_VISION=google:gemini-3.5-flash
MODEL_DESCRIBE=google:gemini-3.5-flash-lite
MODEL_UTILITY=google:gemini-3.1-flash-lite
# 6th role, ONLY used when RESEARCH_ARCH=topics (topic agents inside the research
# lead). Must differ from the other roles' models. Leave empty for RESEARCH_ARCH=single.
# Suggestion: groq:qwen/qwen3.6-27b  (check it still exists: python -m app.main --models)
MODEL_RESEARCH_TOPIC=

# ---------------------------------------------------------------------------
# Running low on one model? List what your key can use, then swap that line:
#   python -m app.main --models
#
# Want everything on Gemini instead?
#   LLM_PROVIDER=google  and set every MODEL_* to google:gemini-3.x-flash
#
# Want real OpenAI (like the original tutorial)?
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-proj-...     and every MODEL_* to openai:gpt-4o-mini
#
# WARNING: never point LLM_BASE_URL at Gemini's OpenAI-compatible endpoint
# (.../v1beta/openai/) with an "AQ." key - it returns 401 invalid_api_key.
# Use the google: prefix instead.
# ---------------------------------------------------------------------------

# Research tools
ARXIV_TOP_K=2
ARXIV_MAX_CHARS=1000
WIKIPEDIA_TOP_K=2
WIKIPEDIA_MAX_CHARS=2000
# Tran so luot tim kiem cho MOT cau hoi. Day la phanh chong vong lap ReAct:
# model lap lai mot truy van cho toi khi hoi thoai phinh to va Groq tra 400.
# Ha xuong 4 neu van dinh loi output_parse_failed.
RESEARCH_MAX_SEARCHES=6
# Wikimedia REQUIRES a custom User-Agent, format: AppName/version (contact)
WIKIPEDIA_USER_AGENT=VisualAgenticAI/1.0 (contact: nhom-do-an@example.com)

# Research architecture. single = one ReAct agent (default, old behaviour).
# topics = a research lead that calls topic agents (scholar_agent, explainer_agent).
RESEARCH_ARCH=single
# Search limits profile for RESEARCH_ARCH=topics: eco | standard | full
RESEARCH_MODE=standard
# OpenAlex needs a free key since 02/2026 (openalex.org). Empty -> OpenAlex is skipped.
OPENALEX_API_KEY=
# Optional. Without a key Semantic Scholar often answers 429.
SEMANTIC_SCHOLAR_API_KEY=
# Optional. Raises the PubMed (NCBI E-utilities) rate limit.
NCBI_API_KEY=

# Vision tools
# yolo11n.pt ~5MB (dev, needs ultralytics+torch ~2GB install)
# yolo11n.onnx    same weights, runs on onnxruntime, no torch needed.
#                 USE THIS ON THE DEPLOYED SERVER: peak RAM ~123MB vs ~780MB,
#                 and Render Free only gives 512MB for the whole process.
# yolo11x.pt ~109MB - better accuracy, local demo/report only.
YOLO_WEIGHTS=yolo11n.pt
# Confidence threshold for YOLO detections - lower catches more, more false positives.
YOLO_CONF=0.25
# NMS IoU threshold - overlapping boxes of the same class above this ratio get
# merged into one. Lower = more aggressive de-duplication.
YOLO_IOU=0.45
# Save a copy of the image with detection boxes drawn on it next to the
# original ("<name>_detected.jpg"). Off by default to avoid littering assets/.
DRAW_DETECTIONS=false
# `detail` is an OpenAI-only parameter. Keep EMPTY unless the describe model
# actually runs on OpenAI.
VISION_DETAIL=
IMAGE_DESCRIBER_RETURN_DIRECT=false
# Bat/tat luu them anh da khoanh vung khi dem vat the. Mac dinh TAT de khong
# sinh file "_detected.jpg" rac moi lan hoi. Can ultralytics da cai (xem README)
# VA bien nay = true thi giao dien web moi hien duoc "Anh da khoanh vung".
DRAW_DETECTIONS=false

# Web UI - conversation history storage
# EMPTY -> SQLite file conversations.db inside the repo. Fine for local dev.
# WHEN YOU DEPLOY this MUST point at a Postgres outside Render: Render free
# tier wipes the disk on every restart/deploy, so a SQLite file on the server
# disappears together with every saved conversation.
#   DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=
# How many past question/answer turns get replayed to the agents when someone
# continues an old conversation. Higher = remembers more, costs more tokens on
# EVERY LLM call of the new turn. 0 disables follow-up memory entirely.
HISTORY_MAX_TURNS=6

# Web UI - image memory (app/image_memory.py). Signed-in conversations only.
# How many of the MOST RECENT images of one conversation stay usable: a reduced
# copy (1024px JPEG, about 100-200KB) is kept in the database so the image can
# be analysed again days later, even after the server restarted. Older images
# lose the stored copy; their text profile stays. Not limited by HISTORY_MAX_TURNS.
IMAGE_MEMORY_MAX=20
# true  -> every NEW image costs ONE extra call to the "utility" model, which
#          writes a short structured profile (subject, count, colors, scene).
#          This is what tells two images of the same kind apart ("the orange
#          cat" vs "the black cat"). MODEL_UTILITY must be a multimodal model.
# false -> no extra call; the profile is only a snippet of the first answer.
IMAGE_PROFILE_LLM=true
# true  -> each image gets a topic (animal / travel / food / document / general) and
#          the step that looks at the image gets extra instructions for that topic.
#          No extra model call, but a NEW image is profiled BEFORE it is answered
#          (needs IMAGE_PROFILE_LLM=true to know the topic; otherwise the topic
#          is guessed from the wording of the question only).
# false -> behave exactly as before topics existed.
VISION_TOPICS=true
# true  -> a question about an image that does NOT need counting is answered by ONE
#          call of the "describe" model (MODEL_DESCRIBE, must be multimodal) that looks
#          at the image and answers directly - much faster and uses less free quota.
#          "How many ..." questions still go through YOLO, and if the fast call fails
#          the old agent chain runs instead.
# false -> always use the old chain (supervisor -> vision agent -> image_describer).
VISION_DIRECT=true

# Web UI - sign in with Google (optional)
# BOTH must be filled for sign-in to turn on. Leave both EMPTY and the web runs
# in anonymous mode: history is kept per browser, and opening the site on
# another machine shows nothing.
# GOOGLE_CLIENT_ID is PUBLIC (it is embedded in the page sent to the browser).
# Get one at https://console.cloud.google.com/apis/credentials
#   Create credentials -> OAuth client ID -> Web application
#   Authorized JavaScript origins: http://localhost:8000 (dev)
#                                  https://<your-app>.onrender.com (deployed)
# Full step-by-step: docs/DEPLOY.md section 9.
GOOGLE_CLIENT_ID=
# SESSION_SECRET is a REAL SECRET: it signs this app's own sign-in tickets.
# Anyone who knows it can forge a ticket and read another person's history.
# Generate a random one:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Days a sign-in stays valid before the person has to sign in again.
SESSION_DAYS=30

# Runtime
RECURSION_LIMIT=50

# LangSmith tracing (optional) - ONE PROJECT PER PERSON so traces do not mix
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=visual-agentic-ai-tuan
